<?xml version="1.0" encoding="utf-8"?>
<!--
  iTantra core service layer.

  NOTE THE ABSENCE OF android.permission.INTERNET.

  That omission is deliberate and load-bearing. Without it the OS refuses every
  socket to a non-local address, so the "fully offline" constraint is enforced by
  the platform rather than by developer discipline. Any future code that tries to
  reach the network -- including a transitive dependency phoning home -- fails at
  runtime instead of silently succeeding. Do not add it. If a build ever needs it,
  that is a design change to escalate, not a build fix.

  ACCESS_FINE_LOCATION is required by the platform for Wi-Fi Direct peer discovery
  on API 24+ (and NEARBY_WIFI_DEVICES from API 33). It is not used for positioning.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Wi-Fi Direct -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- Bluetooth RFCOMM -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

</manifest>
